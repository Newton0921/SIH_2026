# Copy this to .env and fill in your keys
# NEVER commit .env to version control

# VirusTotal free tier: 4 req/min, 500 req/day
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB free tier: 1000 req/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ThreatFox (optional — only needed if live IOC search is enabled)
# Feodo Tracker and URLhaus bulk feeds do NOT require a key
# THREATFOX_API_KEY=your_threatfox_api_key_here

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex())")
FLASK_SECRET_KEY=change_me_to_a_random_secret
